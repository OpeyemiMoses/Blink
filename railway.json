{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": [
            "nodejs_20",
            "npm-10_x"
          ]
        },
        "install": {
          "cmds": [
            "npm ci --ignore-scripts"
          ]
        },
        "build": {
          "cmds": [
            "CI=1 npm run build"
          ]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "node server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
