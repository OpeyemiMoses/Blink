# Privy Configuration
# Create a free project at https://dashboard.privy.io to retrieve your App ID
EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id-here

# Solana Network Configuration
EXPO_PUBLIC_SOLANA_NETWORK=devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Platform Developer Treasury Wallet (Receives Pro Subscriptions $2/mo & protocol fees)
# Replace with your official developer Solana wallet public key when ready to accept live payments
EXPO_PUBLIC_PLATFORM_DEV_WALLET=
# Backend Cloud API (Railway or hosted backend URL)
EXPO_PUBLIC_API_URL=https://blink-production-5c36.up.railway.app
